# Без этого файла `COPY . .` в Dockerfile копирует ВЕСЬ контекст сборки в
# образ как есть - включая .env с реальными секретами при локальной сборке
# (`docker compose build` копирует контекст с диска, в отличие от CI, где
# .env просто отсутствует в git-чекауте). Это самое важное, что тут есть -
# остальное просто размер образа/скорость сборки.

# Секреты - самое важное
.env
.env.*
!.env.example
auth.json

# VCS/CI - не нужны в самом образе
.git
.github
.opencode

# Зависимости - устанавливаются заново внутри образа (composer install при
# сборке, npm вообще не запускается в Dockerfile - фронтенд-ассеты сюда не
# входят). Копировать локальный vendor/node_modules только раздувать context.
vendor
node_modules

# IDE/редакторы
.idea
.vscode
.zed
.nova
.cursor
.codex

# Локальные артефакты рантайма - создаются заново при старте контейнера
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore

# Не нужны внутри образа приложения
tests
docker-compose.yml
k8s
grafana
filebeat
*.md
.dockerignore
